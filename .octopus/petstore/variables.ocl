variable "isStepDisabled" {
    value "true" {}
}

variable "testVariable" {
    type = "Certificate"

    value "Certificates-1" {
        channel = ["complicated", "default", "ephemeral-environments"]
    }
}

variable "accountVariable" {
    type = "AzureAccount"

    value "azure-account" {
        channel = ["complicated", "default", "ephemeral-environments"]
    }
}